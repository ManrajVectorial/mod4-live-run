# Policy Assistant settings (PRD §8). Copy to .env and fill in. Never commit .env.
# Blank means unset. Required settings have no default in code.

# --- Model provider (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
CHAT_MODEL=
CHAT_TEMPERATURE=
CHAT_MAX_TOKENS=
GENERATION_ENABLED=
GENERATION_TIMEOUT_SECONDS=

# --- Retrieval (D0, D1, D2, D3) ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_SECONDS=
CHUNK_SIZE=
CHUNK_OVERLAP=
REFUSAL_THRESHOLD=
RETRIEVAL_TOP_K=

# --- Conversation (D8, D9) ---
CONVERSATION_CONTEXT_MESSAGES=
FOLLOWUP_QUERY_QUESTIONS=

# --- API ---
MAX_QUESTION_CHARS=
CORS_ALLOWED_ORIGINS=
HEALTHZ_TIMEOUT_SECONDS=

# --- Stores ---
DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# --- Corpus and tooling ---
CORPUS_DIR=
EVAL_API_BASE_URL=
EVAL_TIMEOUT_SECONDS=
LOG_LEVEL=

# --- Front end (read by the Next.js server-side proxy only) ---
NEXT_PUBLIC_API_BASE_URL=

# --- Docker Compose (local Postgres only) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=
